 "doctype": "Print Format",
 "font_size": 14,
 "html": "\n<div style=\"font-family: sans-serif;\">\n    <table style=\"width: 100%; border-bottom: 2px solid #000; margin-bottom: 20px;\">\n        <tr>\n            <td style=\"width: 50%; text-align: right;\">\n                <h2 style=\"margin:0;\">ATULYA ELECTRICAL PVT. LTD.</h2>\n                <p style=\"margin:0;\">Registered Address, GSTIN: XXXXXXXXXXXXXXX</p>\n                <p style=\"margin:0;\">CIN: XXXXXXXXXX | PAN: XXXXXX</p>\n            </td>\n        </tr>\n    </table>\n    \n    <h3 style=\"text-align: center; text-transform: uppercase;\">Tax Invoice</h3>\n    \n    <table style=\"width: 100%; margin-bottom: 20px;\">\n        <tr>\n            <td style=\"width: 50%; vertical-align: top;\">\n                <strong>Billed To:</strong><br>\n                {{ doc.customer_name }}<br>\n                {{ doc.address_display or '' }}<br>\n                GSTIN: {{ doc.customer_gstin or '' }}<br>\n                Place of Supply: {{ doc.place_of_supply or '' }}\n            </td>\n            <td style=\"width: 50%; vertical-align: top; text-align: right;\">\n                <strong>Invoice No:</strong> {{ doc.name }}<br>\n                <strong>Date:</strong> {{ doc.get_formatted(\"posting_date\") }}<br>\n                <strong>Due Date:</strong> {{ doc.get_formatted(\"due_date\") }}\n            </td>\n        </tr>\n    </table>\n    \n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px;\" border=\"1\" cellpadding=\"5\">\n        <thead>\n            <tr style=\"background-color: #f3f3f3;\">\n                <th>Sr.</th>\n                <th>Item Code & Description</th>\n                <th>HSN</th>\n                <th>Qty</th>\n                 <th>PL Rate</th>\n                <th>PL Disc.</th>\n                <th>Margin Disc.</th>\n                <th>Rate</th>\n                <th>Amount</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for item in doc.items %}\n            <tr>\n                <td style=\"text-align: center;\">{{ loop.index }}</td>\n                <td><b>{{ item.item_code }}</b><br>{{ item.description }}</td>\n                <td>{{ item.gst_hsn_code or '' }}</td>\n                <td style=\"text-align: right;\">{{ item.qty }} {{ item.uom }}</td>\n                <td style=\"text-align: right;\">{{ item.get_formatted(\"price_list_rate\") }}</td>\n                <td style=\"text-align: right;\">{{ item.discount_percentage }}%</td>\n                <td style=\"text-align: right;\">{{ item.margin_rate_or_amount | abs }}%</td>\n                <td style=\"text-align: right;\">{{ item.get_formatted(\"rate\") }}</td>\n                <td style=\"text-align: right;\">{{ item.get_formatted(\"amount\") }}</td>\n                </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n    \n    <table style=\"width: 100%; border-top: 2px solid #000; padding-top: 10px;\">\n        <tr>\n            <td style=\"width: 60%; vertical-align: top;\">\n                <strong>Amount in words:</strong><br>\n                {{ doc.in_words }}<br><br>\n                <strong>Bank Details:</strong><br>\n                Bank Name: XXXXXX<br>\n                A/C No: XXXXXXXXXX<br>\n                IFSC: XXXXXX<br>\n                <br>\n                <strong>Terms & Conditions:</strong><br>\n                1. Goods once sold will not be taken back.<br>\n                2. Subject to local jurisdiction.\n            </td>\n            <td style=\"width: 40%; vertical-align: top;\">\n                <table style=\"width: 100%;\">\n                    {% if doc.discount_amount %}\n                    <tr><td style=\"text-align: right;\">Addl. Discount:</td><td style=\"text-align: right;\">{{ doc.get_formatted(\"discount_amount\") }}</td></tr>\n                    {% endif %}\n                    <tr><td style=\"text-align: right;\">Total Taxable:</td><td style=\"text-align: right;\">{{ doc.get_formatted(\"net_total\") }}</td></tr>\n                    <tr><td style=\"text-align: right;\">Total Taxes:</td><td style=\"text-align: right;\">{{ doc.get_formatted(\"total_taxes_and_charges\") }}</td></tr>\n                    <tr><td style=\"text-align: right;\">Round Off:</td><td style=\"text-align: right;\">{{ doc.get_formatted(\"rounding_adjustment\") }}</td></tr>\n                    <tr><td style=\"text-align: right;\"><strong>Grand Total:</strong></td><td style=\"text-align: right;\"><strong>{{ doc.get_formatted(\"grand_total\") }}</strong></td></tr>\n                    {% if doc.total_advance %}\n                    <tr><td style=\"text-align: right;\">Advance Paid:</td><td style=\"text-align: right;\">{{ doc.get_formatted(\"total_advance\") }}</td></tr>\n                    {% endif %}\n                    {% if doc.paid_amount %}\n                    <tr><td style=\"text-align: right;\">Paid Amount:</td><td style=\"text-align: right;\">{{ doc.get_formatted(\"paid_amount\") }}</td></tr>\n                    {% endif %}\n                    {% if doc.outstanding_amount > 0 %}\n                    <tr><td style=\"text-align: right;\"><strong>Balance Due:</strong></td><td style=\"text-align: right;\"><strong>{{ doc.get_formatted(\"outstanding_amount\") }}</strong></td></tr>\n                    {% endif %}\n                </table>\n            </td>\n        </tr>\n    </table>\n</div>\n",
